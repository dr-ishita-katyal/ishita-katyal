# ---- Server ----
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# ---- Database ----
MONGO_URI=mongodb://127.0.0.1:27017/ishita-katyal

# ---- Auth ----
# Use a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# ---- Seed admin (used once by `npm run seed`) ----
ADMIN_EMAIL=admin@ishitakatyal.com
ADMIN_PASSWORD=ChangeMe!2026
ADMIN_NAME=Site Administrator

# ---- Cloudinary (server-side only, never exposed to the browser) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ishita-katyal
